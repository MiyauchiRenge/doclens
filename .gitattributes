# 统一换行符，避免 Windows 上检出后 shell 脚本变成 CRLF 而在 Linux 跑不起来
* text=auto

*.sh    text eol=lf
*.conf  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.py    text eol=lf
*.js    text eol=lf
Dockerfile text eol=lf

# 二进制
*.ttf   binary
*.ttc   binary
*.otf   binary
*.wasm  binary
*.png   binary
*.jpg   binary
*.tar   binary
*.gz    binary
