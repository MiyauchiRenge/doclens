# ---------------------------------------------------------------------------
# 全局版本与地址定义。构建机（build-bundle.sh）与目标机（install.sh）共用。
#
# 【必须核实】下面三个镜像 tag 是本包唯一的外部依赖，请在你的联网构建机上
# 先确认它们存在，再执行打包。任一不存在，构建脚本会明确报错停下，
# 不会产出一个"看起来成功但装不上"的包。
# ---------------------------------------------------------------------------

# 预览/转码引擎：kkFileView 官方镜像
#
# 【已核实 2026-10-22】Docker Hub 上 keking/kkfileview 的可用 tag 中
# 最高版本是 4.1.0（不存在 4.4.0，原先的猜测已证伪）。
# 可用 tag 参考：latest / 4.1.0 / v4.0.0 / 4.1.0-SNAPSHOT / v3.6.0 ...
KK_IMAGE="keking/kkfileview"
KK_VERSION="4.1.0"

# 静态 Web 服务
NGINX_IMAGE="nginx"
NGINX_VERSION="1.27-alpine"

# 本项目自建的 portal 服务（上传/路由/PDF转Word/一次性下载）
PORTAL_IMAGE="fileview/portal"
PORTAL_VERSION="1.0.1"

# 基础镜像（构建 portal 时用）
PYTHON_IMAGE="python"
PYTHON_VERSION="3.11-slim"

# 运行时参数（install.sh 会写入 .env）
HTTP_PORT="8080"
SESSION_TTL="1800"
MAX_UPLOAD_MB="200"
CONVERT_TIMEOUT="300"
CONVERT_CONCURRENCY="1"
OCR_TIMEOUT="1800"
OCR_CONCURRENCY="1"
TMPFS_SIZE="2g"

# kkFileView 的 JVM 参数。小内存宿主（≤4G）必须限制 -Xmx：
# 否则 JVM 按物理内存推算堆大小，与 LibreOffice 抢内存直接崩。
KK_JAVA_OPTS="-Xms128m -Xmx768m -XX:MaxMetaspaceSize=256m -XX:+UseSerialGC"
