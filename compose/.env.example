# 本文件由 install.sh 自动生成到 /opt/fileview/.env
# 修改后需重新执行：docker compose up -d（在 /opt/fileview/compose 下）

COMPOSE_PROJECT_NAME=fileview

# 对外端口
HTTP_PORT=8080

# 会话存活时间（秒）。超时后临时文件被清理，这是"退出即清"之外的兜底。
SESSION_TTL=1800

# 单文件上传上限（MB）
MAX_UPLOAD_MB=200

# PDF 转 Word 硬超时（秒）——超时会强杀转换子进程
CONVERT_TIMEOUT=300

# 同时进行的转换任务数。PDF转Word 是 CPU 密集型，建议 1~2。
CONVERT_CONCURRENCY=1

# OCR（扫描件转 Word）：单任务超时（秒）与并发数。
# OCR 每页数秒，200 页的文档需要较长时间，超时给足。
# 并发建议固定为 1：3~4G 内存的机器同时跑两个 OCR 会 OOM。
OCR_TIMEOUT=1800
OCR_CONCURRENCY=1

# portal 的 tmpfs 大小（临时文件全在内存里）
TMPFS_SIZE=2g

# kkFileView 的 JVM 参数。
# 小内存机器（≤4G）必须限制 -Xmx，否则 JVM 与 LibreOffice 抢内存导致崩溃。
# 内存 ≥8G 时可放宽到 -Xmx1536m 以提升大文档处理能力。
KK_JAVA_OPTS=-Xms128m -Xmx768m -XX:MaxMetaspaceSize=256m -XX:+UseSerialGC

# ---------- 镜像坐标（与 versions.env 保持一致） ----------
NGINX_IMAGE=nginx
NGINX_VERSION=1.27-alpine
KK_IMAGE=keking/kkfileview
KK_VERSION=4.1.0
PORTAL_IMAGE=fileview/portal
PORTAL_VERSION=1.0.1
